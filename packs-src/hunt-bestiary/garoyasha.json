    {
      "_id": "sJW64Y9if7NEWnts",
      "_key": "!actors.items!LHNGfSXq09KzdTlk.sJW64Y9if7NEWnts",
      "name": "Lunar Dust",
      "img": "icons/skills/movement/arrow-upward-yellow.webp",
      "effects": [],
      "sort": 600,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>The garoyasha shakes out a cloud of shimmering violet dust. The area of the dust consists of up to eight 5-foot Cubes, which the garoyasha arranges as it chooses. Each Cube must be contiguous with at least one other Cube or the garoyasha. The clouds last for 1 minute or until dispersed by a strong wind. When a creature within the dust takes Bludgeoning, Piercing, Radiant, or Slashing damage, the dust cloud explodes, dealing 5 (2d4) Radiant damage to each creature within it. When a dust cloud explodes, each dust cloud adjacent to it explodes as well.</p>",
          "chat": ""
        },
        "type": {
          "value": "monster",
          "subtype": ""
        },
        "activation": {
          "type": "bonus",
          "cost": 1,
          "condition": ""
        },
        "requirements": "",
        "uses": {
          "spent": 0,
          "recovery": []
