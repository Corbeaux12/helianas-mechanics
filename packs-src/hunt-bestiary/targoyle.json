  "items": [
    {
      "_id": "bdyQeZB5ZjdXaLTB",
      "_key": "!actors.items!zd00xInp6inIJDgw.bdyQeZB5ZjdXaLTB",
      "name": "Heated Core",
      "img": "icons/magic/symbols/runes-carved-stone-green.webp",
      "effects": [],
      "sort": 100,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>If the targoyle takes 10+ Fire damage in a single instance, its core becomes heated for 1 minute, until the targoyle is submerged in water, or until it takes 10+ Cold damage in a single instance. While its core is heated, the targoyle takes a -2 penalty to AC (AC 15), it gains a Fly Speed of 20 feet, its Bite attack deals extra Fire damage on a hit (included in the attack), and it can use its Heat Beam action.</p>",
          "chat": ""
        },
        "type": {
          "value": "monster",
          "subtype": ""
        },
