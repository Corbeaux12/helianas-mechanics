  "items": [
    {
      "_id": "au3ljELTqfuhDSXm",
      "_key": "!actors.items!07d4vAfCzD7Kk3Hj.au3ljELTqfuhDSXm",
      "name": "Elements of Divinity",
      "type": "feat",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": {
          "value": "<p>The jinn's form is built from four ceremonial jars. Each jar depicts the visage of a different god and is associated with a damage type:</p><ul><li><strong>God of the Forge.</strong> Fire</li><li><strong>God of the Storm.</strong> Lightning</li><li><strong>God of the Sun.</strong> Radiant</li><li><strong>God of the Underworld.</strong> Necrotic</li></ul><p>Each jar is positioned at a different location on the jinn: head, body, left arm, and right arm. The jinn has Resistance to the damage type associated with its body's jar.</p>",
          "chat": ""
        },
        "type": {
          "value": "monster",
          "subtype": ""
        },
