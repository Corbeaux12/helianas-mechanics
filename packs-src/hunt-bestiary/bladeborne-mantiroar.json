      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>The mantiroar lets out a roar of challenge, unravelling magical obstructions that would taint honourable combat. Spells of level 3 or lower within 60 feet of the mantiroar end.</p>",
