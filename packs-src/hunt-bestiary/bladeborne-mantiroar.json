    {
      "_id": "73zxGYjK37pPlDIw",
      "_key": "!actors.items!6yT0KH5tLVy0dm3s.73zxGYjK37pPlDIw",
      "name": "Heroic Charge",
      "img": "icons/skills/movement/arrow-upward-yellow.webp",
      "effects": [],
      "sort": 700,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>The mantiroar wreaths itself in golden light and charges 40 feet in a straight line, passing through the spaces of creatures smaller than it. <em>Saving Throw:</em> DC 17 Dexterity, each creature in the mantiroar's path. <em>Failure:</em> 19 (3d12) Bludgeoning damage, and the target is knocked Prone. <em>Success:</em> Half damage only.</p><p>The charge leaves a glowing light in the affected area. At the end of the next enemy's turn, the light flashes brightly, dealing 9 (2d8) Radiant damage to each creature in the area.</p>",
          "chat": ""
        },
