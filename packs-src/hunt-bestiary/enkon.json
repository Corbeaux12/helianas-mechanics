      "name": "Endless Fury",
      "img": "icons/magic/symbols/runes-carved-stone-green.webp",
      "effects": [],
      "sort": 200,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>If damage reduces the enkon to 0 Hit Points, it makes a Charisma saving throw (DC 5 plus the damage taken) unless the damage is from a Critical Hit. The enkon adds its rage level to the total of its roll. On a successful save, the enkon drops to 1 Hit Point instead.</p>",
          "chat": ""
        },
