    {
      "_id": "YqiXHVBDsRZvmP1Q",
      "_key": "!actors.items!bif5WhijchARCI2i.YqiXHVBDsRZvmP1Q",
      "name": "Volatile Punch",
      "img": "icons/skills/melee/unarmed-punch-fist.webp",
      "effects": [],
      "sort": 300,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "weapon",
      "system": {
        "type": {
          "value": "natural",
          "baseItem": ""
        },
        "description": {
          "value": "<p><em>Melee Weapon Attack:</em> +9, reach 10 ft. <em>Hit:</em> 12 (2d6 + 5) Bludgeoning damage. If the target isn't already coated with volatile slime, it becomes coated. The slime can be washed off as an action with 1 gallon of water. The next time the coated target takes Bludgeoning damage, the slime burns away violently and the target suffers one of the following effects (roll 1d6; reroll if the eyebrawl has already used that effect since the start of its last turn):</p><ol><li><strong>Igniting Slime.</strong> The target takes 3 (1d6) Fire damage.</li><li><strong>Corrosive Slime.</strong> The target takes 5 (2d4) Acid damage.</li><li><strong>Concussive Slime.</strong> The target takes 4 (1d8) Thunder damage and its Speed is halved until the end of its next turn.</li><li><strong>Forceful Slime.</strong> The target takes 3 (1d6) Force damage and is pushed 15 feet in a random direction, landing Prone.</li><li><strong>Blinding Slime.</strong> The target takes 4 (1d8) Radiant damage and is Blinded until the end of its next turn.</li><li><strong>Explosive Slime.</strong> The target takes 7 (2d6) Fire damage and each creature within 5 feet of it takes 2 (1d4) Fire damage.</li></ol>",
          "chat": ""
        },
