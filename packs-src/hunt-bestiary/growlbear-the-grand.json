    {
      "_id": "OdJkf3kChnACdb6p",
      "_key": "!actors.items!qsKgRb044u2EsI7y.OdJkf3kChnACdb6p",
      "name": "Inhale (Recharge 5-6)",
      "img": "icons/skills/melee/strike-weapons-orange.webp",
      "effects": [],
      "sort": 800,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p><em>Saving Throw:</em> DC 14 Strength, each Medium or smaller creature in a 30-foot Cone. <em>Failure:</em> The target is swallowed by Growlbear (it can have up to four Medium creatures swallowed at a time). A swallowed creature is Blinded and Restrained, it has Total Cover against attacks and other effects outside Growlbear, and it takes 5 (2d4) Acid damage at the start of each of Growlbear's turns.</p><p>If Growlbear takes 15+ damage in a single instance from a creature inside him, Growlbear must succeed on a DC 14 Constitution saving throw or regurgitate all swallowed creatures, each of which fall Prone in the nearest unoccupied space within 10 feet of Growlbear. If Growlbear dies, a swallowed creature is no longer Restrained by him and can escape from the corpse using 15 feet of movement, exiting Prone.</p>",
          "chat": ""
        },
        "type": {
          "value": "monster",
          "subtype": ""
        },
