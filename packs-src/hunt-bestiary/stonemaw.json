      "effects": [],
      "sort": 200,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>If the stonemaw is motionless underground at the start of combat, it has Advantage on its Initiative roll. Moreover, if a creature hasn't observed the stonemaw move or act, that creature must succeed on a DC 18 Intelligence (Investigation) check to discern that the stonemaw's teeth aren't ordinary stones.</p>",
          "chat": ""
        },
