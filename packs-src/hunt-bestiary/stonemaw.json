    {
      "_id": "3xLKz1mZobE6AzxS",
      "_key": "!actors.items!BlBG1lwZ74k2xVLV.3xLKz1mZobE6AzxS",
      "name": "Emergent Pulse",
      "img": "icons/magic/lightning/orb-ball-spiral-blue.webp",
      "effects": [],
      "sort": 100,
      "ownership": {
        "default": 0
      },
      "flags": {},
      "type": "feat",
      "system": {
        "description": {
          "value": "<p>When the stonemaw emerges from underground for the first time on a turn, nearby creatures are flung backwards. <em>Saving Throw:</em> DC 16 Dexterity, each creature within 5 feet of the stonemaw when it surfaces. <em>Failure:</em> 7 (2d6) Bludgeoning damage, and the target is pushed 10 feet straight away from the stonemaw and knocked Prone. <em>Success:</em> Pushed away only.</p>",
          "chat": ""
        },
        "type": {
