    {
      "_id": "ceMBMTZCPjk4qFIX",
      "_key": "!actors.items!BlBG1lwZ74k2xVLV.ceMBMTZCPjk4qFIX",
      "name": "Bite",
      "img": "icons/creatures/abilities/fangs-teeth-bite.webp",
